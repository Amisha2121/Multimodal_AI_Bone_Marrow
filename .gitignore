# .gitignore

# ── Secrets & credentials ─────────────────────────────────────────────────────
.env

# ── Data (included as requested) ──────────────────────────────────────────────
# (data files are tracked)
data/kaggle/
data/processed/cell_crops/
data/new_patient_cache/


# ── Model weights & checkpoints ───────────────────────────────────────────────
*.pt
*.pth
*.bin
*.safetensors
!models/checkpoints/
!models/checkpoints/best_vit_lora_morphology.pt
runs/
wandb/

# ── FAISS index ───────────────────────────────────────────────────────────────
*.faiss
*.index
retrieval/indexes/
!data/processed/retrieval_index/dense_index.faiss

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/

# ── Backups ───────────────────────────────────────────────────────────────────
backup_*/

.streamlit/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
