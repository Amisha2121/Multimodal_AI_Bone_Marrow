# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy to .env and fill in values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API ──────────────────────────────────────────────────────────────────
# Required for Groq LLM (Llama models). Get your free API key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Required for Gemini LLM. Get your API key at https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Hugging Face ──────────────────────────────────────────────────────────────
# Not required for Mistral-7B or Phi-3-mini (both open-access).
# Required only if you switch to a gated model (e.g. Llama-3.1, UNI, CONCH).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ── TCIA ─────────────────────────────────────────────────────────────────────
# Used by data/download_tcia.py.
# Register at https://www.cancerimagingarchive.net/ then paste credentials here.
TCIA_USERNAME=your_tcia_username
TCIA_PASSWORD=your_tcia_password

# ── Weights & Biases (optional) ───────────────────────────────────────────────
# Set wandb_enabled: true in configs/default.yaml to activate logging.
# WANDB_API_KEY=your_wandb_api_key
# WANDB_PROJECT=bonemarrow-vision

# ── Paths (optional overrides) ────────────────────────────────────────────────
# Override default data paths from config if needed for your environment.
# DATA_RAW_DIR=/mnt/ssd/bonemarrow/raw
# DATA_KB_DIR=/mnt/ssd/bonemarrow/knowledge_base
